# Shared JWT configuration (used by both auth-server and blog-server)
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Express server ports and allowed frontend origins
AUTH_PORT=4000
BLOG_PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000,http://localhost

# MariaDB / XAMPP MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_platform
